{
  "version": "1.0.0",
  "type": "typography",
  "tokens": {
    "fontFamily": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 700, "letterSpacing": "-0.03em" },
      "h1": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 700, "letterSpacing": "-0.02em" },
      "h2": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600, "letterSpacing": "-0.01em" },
      "h3": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "0" },
      "body": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "0" },
      "small": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0.01em" },
      "caption": { "fontSize": "11px", "lineHeight": "14px", "fontWeight": 500, "letterSpacing": "0.02em" }
    }
  }
}
