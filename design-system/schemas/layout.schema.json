{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayoutManifestSchema",
  "description": "Schema for machine-readable layout manifests",
  "type": "object",
  "required": ["name", "type", "description", "regions", "responsive"],
  "properties": {
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["layout"] },
    "description": { "type": "string" },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "description"],
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" },
          "defaultComponent": { "type": "string" }
        }
      }
    },
    "responsive": { "type": "object" }
  }
}
