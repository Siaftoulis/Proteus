{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageTemplateManifestSchema",
  "description": "Schema for machine-readable page template manifests",
  "type": "object",
  "required": ["name", "type", "description", "layout", "slots", "samplePayload"],
  "properties": {
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["template"] },
    "description": { "type": "string" },
    "layout": { "type": "string" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region", "allowedComponents"],
        "properties": {
          "region": { "type": "string" },
          "allowedComponents": { "type": "array", "items": { "type": "string" } },
          "defaultComponent": { "type": "string" }
        }
      }
    },
    "samplePayload": { "type": "object" }
  }
}
