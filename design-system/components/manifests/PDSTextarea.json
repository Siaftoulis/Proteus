{
  "name": "PDSTextarea",
  "type": "primitive",
  "description": "Multi-line text input field with configurable rows and error validation",
  "props": {
    "label": { "type": "string" },
    "placeholder": { "type": "string" },
    "value": { "type": "string" },
    "rows": { "type": "number", "default": 4 },
    "disabled": { "type": "boolean", "default": false },
    "error": { "type": "string" }
  },
  "variants": {
    "default": { "border": "border.subtle", "bg": "canvas.base", "color": "text.main" },
    "error": { "border": "feedback.danger", "bg": "canvas.base", "color": "text.main" }
  },
  "states": ["default", "hover", "focus", "disabled", "error"],
  "responsive": true,
  "accessible": true,
  "implementation": {
    "web": "proteus-web/src/ui_css.rs:textarea.pds-textarea",
    "desktop": "crm-ui/src/components/ or egui::TextEdit::multiline"
  }
}
