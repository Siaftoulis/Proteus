{
  "name": "PDSContainer",
  "type": "primitive",
  "description": "Responsive layout container that constrains content to maximum width with centered alignment",
  "props": {
    "maxWidth": { "type": "string", "enum": ["sm", "md", "lg", "xl", "full"], "default": "xl" },
    "padding": { "type": "string", "default": "spacing.lg" }
  },
  "variants": {
    "sm": { "maxWidth": "640px" },
    "md": { "maxWidth": "768px" },
    "lg": { "maxWidth": "1024px" },
    "xl": { "maxWidth": "1280px" },
    "full": { "maxWidth": "100%" }
  },
  "states": ["default"],
  "responsive": true,
  "accessible": true,
  "implementation": {
    "web": "proteus-web/src/ui_css.rs:.pds-container",
    "desktop": "crm-ui/src/components/ or egui central container"
  }
}
