{
  "version": "1.0.0",
  "description": "Proteus Authoritative Semantic Design Tokens",
  "colors": {
    "canvas": {
      "base": "#0c0e14",
      "surface": "#151821",
      "surfaceHover": "#1b202e",
      "surfaceActive": "#22283a"
    },
    "border": {
      "subtle": "#262c3d",
      "focus": "#3b82f6",
      "bright": "#3b4661"
    },
    "text": {
      "main": "#f1f5f9",
      "muted": "#94a3b8",
      "faint": "#64748b",
      "inverse": "#0f172a"
    },
    "brand": {
      "primary": "#3b82f6",
      "primaryHover": "#2563eb",
      "secondary": "#1e2436",
      "accent": "#00f0ff"
    },
    "feedback": {
      "success": "#10b981",
      "successBg": "rgba(16, 185, 129, 0.12)",
      "warning": "#f59e0b",
      "warningBg": "rgba(245, 158, 11, 0.12)",
      "danger": "#ef4444",
      "dangerBg": "rgba(239, 68, 68, 0.12)",
      "info": "#38bdf8",
      "infoBg": "rgba(56, 189, 248, 0.12)"
    }
  },
  "spacing": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px"
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace"
    },
    "scale": {
      "display": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 700 },
      "h1": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 700 },
      "h2": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600 },
      "h3": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600 },
      "body": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 },
      "small": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500 },
      "caption": { "fontSize": "11px", "lineHeight": "14px", "fontWeight": 500 }
    }
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.3)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.3)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -4px rgba(0, 0, 0, 0.4)",
    "focusRing": "0 0 0 2px rgba(59, 130, 246, 0.5)"
  },
  "breakpoints": {
    "mobile": "640px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px"
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "150ms", "normal": "250ms", "slow": "400ms" },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)" }
  }
}
